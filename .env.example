# Copy to .env.local. Every value is optional; the app runs without any of them.

# SQLite file location. Must be on persistent disk.
DATABASE_URL=file:./data/dynasty-desk.db

# Optional AI explanations. On when OPENAI_API_KEY is set; AI_PROVIDER=none forces deterministic templates.
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini
# Any OpenAI-compatible endpoint, e.g. a local Ollama server: http://localhost:11434/v1
OPENAI_BASE_URL=

# Optional player prop lines for start/sit projections. Free key: https://sportsgameodds.com/pricing
SPORTSGAMEODDS_API_KEY=
